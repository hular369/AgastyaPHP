#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

// Ensure assertion exceptions are thrown
@ini_set('assert.exception', '1');

$testDir = __DIR__ . '/../tests/Unit';
$testFiles = glob($testDir . '/*Test.php');

if (!$testFiles) {
    echo "No test files found in {$testDir}\n";
    exit(1);
}

$startTime = microtime(true);
$totalTests = 0;
$passed = 0;
$failed = 0;
$failures = [];

echo "\n\033[1;36mStreamForge PHP Test Runner\033[0m\n";
echo str_repeat('=', 60) . "\n\n";

foreach ($testFiles as $file) {
    require_once $file;
    $className = 'StreamForge\\Tests\\Unit\\' . basename($file, '.php');

    if (!class_exists($className)) {
        continue;
    }

    $ref = new ReflectionClass($className);
    $instance = $ref->newInstance();
    $methods = $ref->getMethods(ReflectionMethod::IS_PUBLIC);

    echo "\033[1;33m" . $ref->getShortName() . "\033[0m\n";

    foreach ($methods as $method) {
        if (!str_starts_with($method->getName(), 'test')) {
            continue;
        }

        $totalTests++;
        $methodName = $method->getName();

        try {
            $t0 = microtime(true);
            $instance->$methodName();
            $t1 = microtime(true);
            $durationMs = round(($t1 - $t0) * 1000, 2);

            echo "  \033[32m✔\033[0m {$methodName} \033[90m({$durationMs}ms)\033[0m\n";
            $passed++;
        } catch (Throwable $e) {
            echo "  \033[31m✘ {$methodName}\033[0m\n";
            $failed++;
            $failures[] = [
                'class' => $ref->getShortName(),
                'method' => $methodName,
                'error' => $e->getMessage(),
                'file' => $e->getFile() . ':' . $e->getLine(),
                'trace' => $e->getTraceAsString(),
            ];
        }
    }
    echo "\n";
}

$totalTime = round((microtime(true) - $startTime) * 1000, 2);
$memMb = round(memory_get_peak_usage(true) / 1024 / 1024, 2);

echo str_repeat('-', 60) . "\n";
if ($failed === 0) {
    echo "\033[1;32mOK ({$totalTests} tests, {$passed} passed) in {$totalTime}ms (Peak Memory: {$memMb}MB)\033[0m\n\n";
    exit(0);
}

echo "\033[1;31mFAILURES! ({$failed} of {$totalTests} tests failed)\033[0m\n\n";
foreach ($failures as $f) {
    echo "\033[31m• {$f['class']}::{$f['method']}\033[0m\n";
    echo "  {$f['error']}\n";
    echo "  at {$f['file']}\n\n";
}

exit(1);
