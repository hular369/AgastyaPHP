{
    "name": "raul369/php-event-processing-framework",
    "description": "A production-grade distributed event processing framework in PHP with concurrent workers, configurable retries, dead-letter queues and Prometheus observability.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "raul369",
            "email": "hular369@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "psr/log": "^3.0",
        "ramsey/uuid": "^4.7",
        "promphp/prometheus_client_php": "^2.10",
        "longlang/phpkafka": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "StreamForge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StreamForge\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php bin/test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
